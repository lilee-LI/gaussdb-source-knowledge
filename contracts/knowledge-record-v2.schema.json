{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"
    },
    "kind": {
      "enum": [
        "errors",
        "objects",
        "mechanisms",
        "procedures",
        "scenarios",
        "synthesis"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 8
    },
    "product": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "markdown": {
      "type": "string",
      "minLength": 100
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "source_kind": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "file",
          "sha256",
          "start_line",
          "end_line"
        ],
        "additionalProperties": true
      },
      "minItems": 1
    },
    "source_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "source_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "snapshot_id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "file_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "quote": {
            "type": "string",
            "minLength": 1
          },
          "quote_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "snapshot_id",
          "path",
          "file_sha256",
          "start_line",
          "end_line"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "quote"
            ]
          },
          {
            "required": [
              "quote_sha256"
            ]
          }
        ]
      },
      "minItems": 1
    },
    "study_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "result_sha256": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "task_id",
          "result_sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "domain_content": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "minLength": 12
        }
      }
    },
    "applicability": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "build_correspondence": {
          "enum": [
            "reviewed",
            "declared",
            "unknown"
          ]
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "scope",
        "build_correspondence",
        "features"
      ],
      "additionalProperties": false
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "lifecycle": {
      "const": "draft"
    },
    "created": {
      "type": "string",
      "minLength": 1
    },
    "updated": {
      "type": "string",
      "minLength": 1
    },
    "validation_status": {
      "enum": [
        "not-run",
        "partial",
        "passed",
        "failed"
      ]
    },
    "validation_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "validation_id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "validation_id",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "source_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "sqlstate": {
      "type": "string",
      "minLength": 1
    },
    "message_patterns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "object_type": {
      "type": "string",
      "minLength": 1
    },
    "feedback_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "type",
          "target"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "scenario_model": {
      "type": "object",
      "required": [
        "phenomenon",
        "supports",
        "excludes",
        "unknown",
        "collections",
        "actions"
      ],
      "properties": {
        "phenomenon": {
          "type": "string",
          "minLength": 1
        },
        "supports": {
          "type": "string",
          "minLength": 1
        },
        "excludes": {
          "type": "string",
          "minLength": 1
        },
        "unknown": {
          "type": "string",
          "minLength": 1
        },
        "collections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "purpose",
              "producer",
              "permission",
              "steps",
              "failure_meaning"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "purpose": {
                "type": "string",
                "minLength": 1
              },
              "producer": {
                "type": "string",
                "minLength": 1
              },
              "permission": {
                "type": "string",
                "minLength": 1
              },
              "steps": {
                "type": "string",
                "minLength": 1
              },
              "failure_meaning": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "sql",
                  "tool",
                  "log",
                  "trace",
                  "manual"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "preconditions",
              "steps",
              "impact",
              "cleanup",
              "failure_exit",
              "verification"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "preconditions": {
                "type": "string",
                "minLength": 1
              },
              "steps": {
                "type": "string",
                "minLength": 1
              },
              "impact": {
                "type": "string",
                "minLength": 1
              },
              "cleanup": {
                "type": "string",
                "minLength": 1
              },
              "failure_exit": {
                "type": "string",
                "minLength": 1
              },
              "verification": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "procedure": {
      "type": "object",
      "required": [
        "objective",
        "preconditions",
        "steps",
        "expected",
        "failure_exit",
        "verification",
        "execution_status"
      ],
      "properties": {
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "preconditions": {
          "type": "string",
          "minLength": 1
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "failure_exit": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "string",
          "minLength": 1
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "execution_status": {
          "enum": [
            "planned",
            "implemented",
            "tested"
          ]
        }
      },
      "additionalProperties": false
    },
    "learning_presentation": {
      "type": "object",
      "properties": {
        "execution_profile": {
          "const": "source_only"
        },
        "sections": {
          "type": "object",
          "properties": {
            "overview": {
              "type": "string",
              "minLength": 1
            },
            "terms": {
              "type": "string",
              "minLength": 1
            },
            "rules": {
              "type": "string",
              "minLength": 1
            },
            "cases": {
              "type": "string",
              "minLength": 1
            },
            "boundaries": {
              "type": "string",
              "minLength": 1
            },
            "sources": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "overview",
            "terms",
            "rules",
            "cases",
            "boundaries",
            "sources"
          ],
          "additionalProperties": false
        },
        "claim_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "task_id": {
                "type": "string",
                "minLength": 1
              },
              "claim_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "task_id",
              "claim_id"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "execution_profile",
        "sections",
        "claim_refs"
      ],
      "additionalProperties": false
    },
    "error_applicability_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "variant_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "task_id",
          "variant_ids"
        ],
        "additionalProperties": false
      }
    },
    "error_learning_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "cause_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "scenario_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "required": [
          "task_id",
          "cause_ids",
          "scenario_ids"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "id",
    "kind",
    "title",
    "summary",
    "product",
    "revision",
    "domains",
    "markdown",
    "sources",
    "source_snapshot_id",
    "source_evidence",
    "study_refs",
    "domain_content",
    "applicability",
    "lifecycle",
    "created",
    "updated",
    "validation_status"
  ],
  "additionalProperties": false
}
