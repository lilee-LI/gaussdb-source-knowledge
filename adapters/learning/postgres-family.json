{
  "schema": "whole-learning-policy/v1",
  "id": "postgres-family-whole",
  "version": "1",
  "partition_max_files": 80,
  "max_pending_per_worker": 4,
  "domains": [
    {"id":"build","title":"构建、配置与发布","patterns":["*/build/*","*/cmake/*","*/config/*","*/cc_build/*","*/src/makefiles/*"]},
    {"id":"session","title":"启动、连接、会话与调度","patterns":["*/process/*","*/postmaster/*","*/tcop/*","*/threadpool/*","*/bootstrap/*","*/backend/libpq/*"]},
    {"id":"frontend","title":"语法、分析、绑定与重写","patterns":["*/parser/*","*/rewrite/*","*/optimizer/prep/*","*/nodes/*"]},
    {"id":"catalog","title":"系统目录、DDL与依赖","patterns":["*/catalog/*","*/commands/*"]},
    {"id":"optimizer","title":"查询优化器","patterns":["*/optimizer/*"]},
    {"id":"executor","title":"执行器与代码生成","patterns":["*/runtime/*","*/executor/*","*/vecexecutor/*","*/opfusion/*","*/codegen/*"]},
    {"id":"semantics","title":"类型、函数与过程语言","patterns":["*/utils/adt/*","*/utils/fmgr/*","*/utils/gsplsql/*","*/common/pl/*","*/timezone/*","*/tsearch/*","*/regex/*"]},
    {"id":"transaction","title":"事务、快照与可见性","patterns":["*/access/transam/*","*/access/heap/*","*/access/ustore/*","*/utils/time/*"]},
    {"id":"storage","title":"页面、缓存、访问与索引","patterns":["*/storage/*","*/access/*"]},
    {"id":"recovery","title":"WAL、恢复、复制与解码","patterns":["*/replication/*","*/access/redo/*","*/access/rmgrdesc/*","*/transam/xlog*","*/transam/*recovery*","*/transam/*rto*","*/access/archive/*"]},
    {"id":"foundation","title":"内存、并发、缓存与公共设施","patterns":["*/utils/mmgr/*","*/utils/resowner/*","*/utils/cache/*","*/utils/error/*","*/storage/lmgr/*","*/storage/ipc/*","*/src/lib/*","*/common/port/*"]},
    {"id":"security","title":"认证、权限与数据安全","patterns":["*/security/*","*/client_logic/*","*/keymgr/*","*/ssl/*","*/libpq/auth*","*/libpq/hba*"]},
    {"id":"communication","title":"节点通信、并行与外部接口","patterns":["*/communication/*","*/pgxc*/*","*/ddes/*","*/process/stream/*","*/foreign/*","*/datasource/*"]},
    {"id":"engines","title":"专用存储与可选引擎","patterns":["*/storage/mot/*","*/storage/cstore/*","*/storage/htap/*","*/storage/dss/*","*/storage/nvm/*","*/storage/gs_uwal/*","*/storage/xlog_share_storage/*"]},
    {"id":"client","title":"客户端库与编程接口","patterns":["*/interfaces/*"]},
    {"id":"tools","title":"工具、安装与运维","patterns":["*/src/bin/*","*/src/tools/*","*/Tools/*","*/docker/*","*/liteom/*","*/simpleInstall/*"]},
    {"id":"extensions","title":"扩展、插件与生态","patterns":["*/contrib/*","*/cbb/extension/*"]},
    {"id":"observability","title":"统计、观测与资源治理","patterns":["*/instruments/*","*/workload/*","*/dbmind/*","*/gstrace/*","*/bbox/*"]},
    {"id":"documents","title":"文档、教程与说明","patterns":["*/doc/*","*/tutorial/*","*.md","*.sgml","*.sgmlin","*.po"]},
    {"id":"tests","title":"测试、预期与数据资产","patterns":["*/src/test/*","*/tests/*","*/storage/test/*"]}
  ],
  "templates": [
    {"id":"B01","kind":"shared_research","title":"内存与资源寿命","patterns":["*/utils/mmgr/*","*/utils/resowner/*","*/memutils.h"],"depends_on":[],"question":"研究分配、所有者、别名、正常/异常清理和可复用接口契约。"},
    {"id":"B02","kind":"shared_research","title":"错误、异常与断言","patterns":["*/utils/error/*","*/elog.h"],"depends_on":[],"question":"研究错误检测、传播、清理、断言配置及可区分证据。"},
    {"id":"B03","kind":"shared_research","title":"GUC与会话生效边界","patterns":["*/guc/*","*/guc.cpp","*/guc.h","*/knl_guc/*"],"depends_on":["B01","B02"],"question":"注册、来源覆盖、消费者、生效阶段和缓存失效哪些已证实？"},
    {"id":"B04","kind":"shared_research","title":"并发与等待协议","patterns":["*/storage/lmgr/*","*/storage/ipc/*"],"depends_on":["B01","B02"],"question":"研究锁序、共享状态、发布、等待唤醒、取消与超时。"},
    {"id":"B05","kind":"shared_research","title":"事务与可见性","patterns":["*/transam/xact*","*/utils/time/*"],"depends_on":["B01","B02"],"question":"研究事务/快照/版本的生产、消费、提交回滚与可见性契约。"},
    {"id":"B06","kind":"shared_research","title":"持久化与恢复","patterns":["*/transam/xlog*","*/access/redo/*"],"depends_on":["B02","B05"],"question":"研究日志、页面、刷盘、检查点和恢复的顺序不变量。"},
    {"id":"B07","kind":"shared_research","title":"系统目录与缓存","patterns":["*/utils/cache/*","*/catalog/*"],"depends_on":["B01","B02"],"question":"研究对象身份、元数据生产消费、缓存所有权和失效。"},
    {"id":"B08","kind":"shared_research","title":"公共数据与SQL语义","patterns":["*/nodes/*","*/utils/fmgr/*","*/datatype/*"],"depends_on":["B01","B02"],"question":"研究Node/Datum/类型/NULL/转换及兼容条件的公共契约。"},
    {"id":"B09","kind":"shared_research","title":"构建、角色与接口","patterns":["*/build_options.cmake","*/pg_config.h","*/CMakeLists.txt"],"depends_on":[],"question":"登记有效构建、宏、架构、节点角色和插件接口；未启用路径单列。"},
    {"id":"B10","kind":"shared_research","title":"观测与字段血缘","patterns":["*/instruments/*","*/pgstat*","*/wait_event*"],"depends_on":["B02"],"question":"研究指标/视图的生产者、快照、节点、重置和采样口径。"},
    {"id":"X01","kind":"integration_research","title":"查询主链","patterns":["*/process/tcop/*","*/optimizer/plan/*","*/executor/execMain*"],"depends_on":["B08"],"question":"贯通请求、SQL绑定、优化、Plan、执行与访问方法，核对数据契约。"},
    {"id":"X02","kind":"integration_research","title":"DML与事务","patterns":["*/executor/nodeModifyTable*","*/transam/xact*","*/access/heap/*"],"depends_on":["B05"],"question":"核对写入、约束、索引、WAL、提交与回滚的接口和异常边界。"},
    {"id":"X03","kind":"integration_research","title":"DDL与缓存失效","patterns":["*/optimizer/commands/*","*/utils/cache/*"],"depends_on":["B03","B07"],"question":"核对对象变更、依赖、失效和计划消费者，不假定SET必使缓存失效。"},
    {"id":"X04","kind":"integration_research","title":"索引读写与属性","patterns":["*/optimizer/path/*","*/access/index/*","*/access/nbtree/*"],"depends_on":["B05","B08"],"question":"核对索引路径、执行访问、可见性、维护与物理属性的两端契约。"},
    {"id":"X05","kind":"integration_research","title":"算子资源与取消","patterns":["*/executor/nodeSort*","*/executor/nodeAgg*","*/utils/sort/*"],"depends_on":["B01","B02"],"question":"核对算子预算、落盘、复用、取消与异常清理。"},
    {"id":"X06","kind":"integration_research","title":"等待与事务终止","patterns":["*/storage/lmgr/*","*/process/tcop/*"],"depends_on":["B04","B05"],"question":"核对锁等待、唤醒/超时/取消、错误传播与事务状态。"},
    {"id":"X07","kind":"integration_research","title":"WAL到恢复","patterns":["*/transam/xlog*","*/access/redo/*"],"depends_on":["B06"],"question":"核对修改、日志、刷盘、恢复分派与页面不变量，不执行崩溃注入。"},
    {"id":"X08","kind":"integration_research","title":"备份、复制与角色","patterns":["*/replication/*","*/pg_basebackup/*"],"depends_on":["B06","B09"],"question":"核对基线、流传输、回放位点、保留、重连与角色变化。"},
    {"id":"X09","kind":"integration_research","title":"解码与插件消费","patterns":["*/replication/logical/*","*/test_decoding/*","*/mppdb_decoding/*"],"depends_on":["B05","B06"],"question":"核对slot、快照、WAL、事务重排、插件、确认及重启。"},
    {"id":"X10","kind":"integration_research","title":"客户端与会话","patterns":["*/interfaces/libpq/*","*/backend/libpq/*"],"depends_on":["B02","B03"],"question":"核对客户端与服务端连接、认证、类型、错误、取消和断开。"},
    {"id":"X11","kind":"integration_research","title":"工具与内核接口","patterns":["*/pg_dump/*","*/pg_probackup/*","*/gs_loader/*"],"depends_on":["B05","B06"],"question":"建立工具选项、SQL/数据阶段、事务及失败重试接口图；详细行为另分研究单。"},
    {"id":"X12","kind":"integration_research","title":"可选引擎与扩展接入","patterns":["*/storage/mot/*","*/storage/cstore/*","*/contrib/*"],"depends_on":["B08","B09"],"question":"核对宏、注册与主链接入契约；目录存在不证明当前配置可用。"}
  ]
}
